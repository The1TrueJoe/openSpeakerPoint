/*
 * Device Tree for the Control4 SpeakerPoint (Cirrus EP9301 / EDB9301
 * reference design). See Research/Speakerpoint/Notes.txt for how this
 * hardware was identified (register dumps, /proc/mtd, dmesg, etc. from
 * the stock firmware).
 *
 * Minimal for now: NOR flash (so the RedBoot partition table / mtdblock3
 * root still work), Ethernet, and the ttyAM0 serial console. Audio
 * (STAC9758 AC97 codec + D2 Audio I2C amp) and the front-panel
 * button/LED are not wired up yet - later milestones.
 */
/dts-v1/;
#include "ep93xx.dtsi"

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "cirrus,edb9301", "cirrus,ep9301";
	model = "control4,speakerpoint";

	chosen {
	};

	memory@0 {
		device_type = "memory";
		/* Matches /proc/iomem on the stock firmware (4x 8MB banks,
		 * 32MB total). Also gets set from ATAGS by RedBoot. */
		reg = <0x0000000 0x800000>,
		      <0x1000000 0x800000>,
		      <0x4000000 0x800000>,
		      <0x5000000 0x800000>;
	};
};

&ebi {
	flash@60000000 {
		/* Intel JS28F128, 16MB, 16-bit bus - see Notes.txt */
		compatible = "cfi-flash";
		reg = <0x60000000 0x1000000>;
		bank-width = <2>;

		/* Stock firmware's RedBoot maintains the authoritative
		 * partition table in the FIS directory, the last 128KB
		 * (0x20000) erase block of the 16MB/128-block flash - see
		 * the "Creating 7 MTD partitions" dump in
		 * Research/Speakerpoint/Notes.txt (mtd7 "FIS directory" at
		 * 0x00fe0000-0x01000000, i.e. block 127). Reading the
		 * partition table from flash (rather than hardcoding offsets
		 * here) means it stays correct even if `fis create` is later
		 * used to resize/rewrite entries. root=/dev/mtdblock3 (the
		 * "cramfs"/rootfs slot in the stock layout) matches the
		 * stock kernel's own cmdline.
		 */
		partitions {
			compatible = "redboot-fis";
			fis-index-block = <127>;
		};
	};
};

&eth0 {
	phy-handle = <&phy0>;
};

&mdio0 {
	phy0: ethernet-phy@1 {
		reg = <1>;
		device_type = "ethernet-phy";
	};
};

&uart0 {
	status = "okay";
};
