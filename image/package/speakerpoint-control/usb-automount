#!/bin/sh
# mdev hotplug handler for USB mass-storage partitions: mounts read-only
# under /media/usb, the control daemon's media library directory.

DEV="/dev/${MDEV}"
MNT="/media/usb"

case "${ACTION:-add}" in
remove)
	umount -f "$MNT" 2>/dev/null || true
	;;
add)
	[ -b "$DEV" ] || exit 0
	mkdir -p "$MNT"
	if ! mountpoint -q "$MNT" 2>/dev/null; then
		mount -t auto -o ro,noatime "$DEV" "$MNT" 2>/dev/null || exit 0
	fi
	;;
esac

exit 0
