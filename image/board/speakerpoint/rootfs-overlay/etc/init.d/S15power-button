#!/bin/sh
# Front-panel power button -> reboot.
#
# Button is Port A line 1 (active-low), confirmed on hardware. No gpio-keys
# driver in this image, so poll the line directly via devmem and reboot on
# press (see S01z-ep93xx-reset for the actual hardware reset path).

PADR=0x80840000
PADDR=0x80840010
BTN_MASK=0x02
PRESSED_LEVEL=0
# Each poll forks devmem (busybox fork+exec). At 1s that's a constant drip of
# process churn on a 166MHz no-FPU CPU, which shows up as audio underrun
# crackle during playback. 2s is still responsive for a power button.
POLL_SECS=2
PIDFILE=/var/run/power-button.pid

masked() {
	v=$(devmem $PADR)
	echo $(( v & BTN_MASK ))
}

watch_loop() {
	# Require a release before ever acting, so a line already reading
	# "pressed" at boot can't trigger an instant reboot loop.
	seen_release=0
	while : ; do
		m=$(masked)
		if [ "$PRESSED_LEVEL" = "0" ]; then
			pressed=$([ "$m" -eq 0 ] && echo 1 || echo 0)
		else
			pressed=$([ "$m" -ne 0 ] && echo 1 || echo 0)
		fi

		if [ "$pressed" = "0" ]; then
			seen_release=1
		elif [ "$seen_release" = "1" ]; then
			sleep 1
			m=$(masked)
			if [ "$PRESSED_LEVEL" = "0" ]; then
				[ "$(( m & BTN_MASK ))" -eq 0 ] && { logger -t power-button "press -> reboot"; reboot; exit 0; }
			else
				[ "$(( m & BTN_MASK ))" -ne 0 ] && { logger -t power-button "press -> reboot"; reboot; exit 0; }
			fi
		fi
		sleep "$POLL_SECS"
	done
}

case "$1" in
start)
	v=$(devmem $PADDR); devmem $PADDR 32 $(( v & ~BTN_MASK ))
	watch_loop &
	echo $! > "$PIDFILE"
	;;
stop)
	[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
	rm -f "$PIDFILE"
	;;
*)
	echo "Usage: $0 {start|stop}" >&2
	exit 1
	;;
esac

exit 0
