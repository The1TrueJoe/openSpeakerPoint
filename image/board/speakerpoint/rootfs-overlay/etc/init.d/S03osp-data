#!/bin/sh
# /data: openSpeakerPoint's persistent settings, on the osp-data jffs2.
#
# Only when this system was booted from flash (an install: / is the squashfs on
# osp-rootfs). A netbooted RAM system may be running on a box that is still
# stock, where osp-data's blocks belong to stock's jffs2 - so there /data is
# plain tmpfs and the flash is never touched. NB: the kernel command line is no
# guide - CONFIG_CMDLINE (root=/dev/mtdblock5) is appended on a netboot too;
# what is actually mounted at / is. On an install, a partition that will not mount
# (first boot, or damage) is formatted rather than leaving the box without
# settings.

mtd_of() { sed -n "s/^\(mtd[0-9]*\): .* \"$1\"\$/\1/p" /proc/mtd | head -n 1; }

case "$1" in
start)
	if [ ! -d /data ]; then
		echo "osp-data: no /data mountpoint in this image"
		exit 0
	fi
	m=$(mtd_of osp-data)
	if [ "$(awk '$2 == "/" { print $3 }' /proc/mounts | tail -n 1)" = squashfs ] && [ -n "$m" ]; then
		dev="/dev/mtdblock${m#mtd}"
		if ! mount -t jffs2 "$dev" /data 2>/dev/null; then
			# The mountpoint exists (checked above), so a failed mount is
			# the partition itself: first boot, or damage.
			echo "osp-data: formatting $m"
			flash_erase -q -j "/dev/$m" 0 0 && mount -t jffs2 "$dev" /data
		fi
	fi
	grep -q " /data " /proc/mounts || mount -t tmpfs -o size=1m tmpfs /data
	mkdir -p /data/dropbear
	;;
stop)
	sync
	umount /data 2>/dev/null
	;;
esac
exit 0
