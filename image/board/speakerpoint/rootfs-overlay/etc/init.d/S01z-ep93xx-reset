#!/bin/sh
# EP93xx hardware reset via watchdog timer.
#
# ep93xx_wdt has no of_match_table so no restart handler registers on a
# DT-only kernel - reboot(2) would just halt. Writing 0xaaaa to the
# watchdog register (0x80940000) arms a 250ms hardware timer instead.
#
# BusyBox's rcK has no real "K-script" concept: it globs /etc/init.d/S??*
# in reverse and calls each with "stop", so the *lowest*-numbered script
# runs last, after everything else has stopped. Named S01z (not K99) so
# it actually runs last during shutdown; "start" is a no-op since rcS
# order doesn't matter here.

case "$1" in
stop)
    sync
    if command -v devmem > /dev/null 2>&1; then
        devmem 0x80940000 32 0xaaaa
    fi
    ;;
start|restart)
    ;;
*)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0
