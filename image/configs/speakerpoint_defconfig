BR2_arm=y
BR2_arm920t=y
# Optimize every package for size (-Os), not speed. This board is flash- and
# RAM-constrained (the rootfs is netbooted as an initramfs into 32 MB RAM);
# the audio path is not CPU-bound enough to miss -O2.
BR2_OPTIMIZE_S=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
# C++ is needed by shairport-sync (AirPlay) and MPD (media playback).
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Dynamic linking (musl's shared libs are lightweight, unlike glibc's) so
# every binary shares one copy of libc/alsa-lib/ncurses/etc. instead of each
# statically duplicating them - the actual fix for multi-binary bloat like
# alsa-utils, rather than trimming one package at a time.
BR2_SHARED_LIBS=y
BR2_TARGET_GENERIC_HOSTNAME="speakerpoint"
BR2_TARGET_GENERIC_ISSUE="Modern Speakerpoint firmware"
BR2_TARGET_GENERIC_ROOT_PASSWD="speakerpoint"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAM0"
# BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP is not set
BR2_TARGET_GENERIC_GETTY_BAUDRATE_57600=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/board/speakerpoint/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/board/speakerpoint/post-build.sh"
# Buildroot only auto-applies patches from a package's own internal
# package/<name>/ dir or from $(BR2_GLOBAL_PATCH_DIR)/<name>/ - dropping a
# patch in our own image/package/<name>/ does nothing without this, since
# BR2_EXTERNAL package dirs aren't scanned for patches by name alone.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/package"
BR2_LINUX_KERNEL=y
# Pinned. The AC97/DMA path is out-of-tree code on a board nobody upstream
# tests: 7.1.4 played audio, while 7.2.9 (what an unpinned Buildroot master
# picked up in October 2026) fails every PCM open with a silent EINVAL - the
# DMA channels never attach. 7.1.8 is also what openHC runs.
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.8"
# The toolchain takes its headers from that kernel, and Buildroot checks the
# declared series against it exactly.
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_7_1=y
BR2_LINUX_KERNEL_DEFCONFIG="ep93xx"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/board/speakerpoint/linux.fragment"
# XZ compresses noticeably better than gzip (RAM is no constraint at
# boot decompression time; mtd2 flash space very much is).
BR2_LINUX_KERNEL_XZ=y
# RedBoot doesn't know how to pass a separate DTB, so append it to the
# zImage (RedBoot just loads+execs the whole blob like it always has).
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/board/speakerpoint/dts-overlay"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="cirrus/ep93xx-speakerpoint"
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_FLASH_ERASE=y
BR2_PACKAGE_MTD_FLASHCP=y
BR2_PACKAGE_MTD_MTDPART=y
BR2_PACKAGE_BUSYBOX_HTTPD=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SPEAKERPOINT_PATH)/board/speakerpoint/busybox.fragment"
# Client tools (dbclient/ssh) default to on but are never invoked on-device -
# this box is only ever an SSH server, never a client. scp/dropbearkey are
# always built server-side regardless of this setting.
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_SPEAKERPOINT_CONTROL=y
BR2_PACKAGE_EP93XX_AC97=y
# Reverted a trimmed PCM_PLUGINS list back to Buildroot's default ("all"):
# it was an unverified-on-hardware size cut, and a hardware regression
# report ("audio output isn't working") landed before it was ever confirmed
# safe. Reintroduce a narrower list later only alongside an actual
# passing re-test of every audio path (RCA/amp/line-in/AirPlay).
BR2_PACKAGE_ALSA_LIB=y
# alsa-utils for testing the AC97/STAC9758 audio path: amixer to unmute/set
# Master Out (AC97 codecs power up muted), aplay for real playback, and
# speaker-test for a quick tone without needing a test file on target.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# alsaloop: captures the STAC line-in ADC and plays it back through the normal
# output path, so external line-in audio can be routed to the RCA out and/or
# the powered amp (the amp is fed from the playback S/PDIF, so line-in has to
# go capture -> playback to reach it).
BR2_PACKAGE_ALSA_UTILS_ALSALOOP=y
# alsamixer defaults to y and pulls in ncurses for its interactive TUI, which
# this headless board (serial console + network only, no local display) has
# no use for; amixer already covers scripted mixer control non-interactively.
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
# i2c-tools (i2cdetect/i2cget/i2cset) for bringing up the D241051QR amp over
# the i2c-gpio bus: confirm which address (0x59/0x5a) actually responds and
# manually replay the recovered init sequence before writing a permanent
# driver/init script.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_I2C_TOOLS=y
# Dynamic /dev + hotplug via BusyBox mdev, so an inserted USB drive gets a
# device node and fires our automount rule (see mdev.conf in the overlay).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# MPD: the media engine. Replaced a hand-rolled mpg123 -R wrapper that never
# gave reliable pause/seek/queue - MPD is a real player daemon with a proper
# control protocol and syslog logging, so failures are visible instead of
# silently doing nothing. Deliberately minimal: MP3 (libmad) + ID3 tags only,
# no FLAC/Vorbis/ffmpeg/curl/network-input, which keeps it to ~2MB. C++ is
# already enabled for shairport-sync, so MPD adds no new toolchain cost.
BR2_PACKAGE_MPD=y
BR2_PACKAGE_MPD_ALSA=y
BR2_PACKAGE_MPD_TCP=y
BR2_PACKAGE_MPD_MAD=y
BR2_PACKAGE_MPD_ID3TAG=y
# shairport-sync: AirPlay 1 receiver. Uses its bundled tinysvcmdns for
# discovery (no Avahi/D-Bus) and mbedTLS (lighter than OpenSSL) for the RAOP
# crypto. The codec is exclusive (no software mixer), so an incoming AirPlay
# stream makes the daemon stop MPD and hand the device over.
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_SHAIRPORT_SYNC=y
BR2_PACKAGE_MOSQUITTO=y
BR2_PACKAGE_MOSQUITTO_BROKER=y
# No websockets yet: in mosquitto 2.1 both implementations pull in OpenSSL,
# which takes the rootfs to 5.85 MB - past osp-rootfs (4.5 MiB).
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_1024K=y
# BR2_TARGET_ROOTFS_TAR is not set
# Also build a gzip cpio image of the same rootfs, for use as a RedBoot
# TFTP-loaded initramfs (see tools/tftp-serve.sh). This lets a whole new
# kernel+rootfs pair be netbooted and tested entirely from RAM before
# anything is written to flash.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
